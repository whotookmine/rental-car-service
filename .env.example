# Copy to .env and adjust as needed. The defaults below point at the PostgreSQL
# service defined in docker-compose.yml, so a fresh clone runs unedited.

# SQLAlchemy database URL for the Compose PostgreSQL service.
DATABASE_URL=postgresql+psycopg://rental:rental@localhost:5433/rental_car_service

# Signing key for access tokens. PLACEHOLDER — generate your own, never commit a real key.
# e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-placeholder-not-a-real-key

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Business timezone used to compute "today" for every date rule.
BUSINESS_TIMEZONE=Asia/Bangkok

# Environment name: local | development | production
ENV=local
